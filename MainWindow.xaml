<Window x:Class="RentSport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RentSport" Height="790" Width="1220" MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#F4F7F5" FontFamily="Segoe UI" Foreground="#20312A">
    <Window.Resources>
        <SolidColorBrush x:Key="Green" Color="#247552"/><SolidColorBrush x:Key="Ink" Color="#20312A"/><SolidColorBrush x:Key="Muted" Color="#819087"/><SolidColorBrush x:Key="Line" Color="#E5ECE7"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E3DC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E3DC"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B6242"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#EAF3ED"/><Setter Property="Foreground" Value="#27664B"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D9EADF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#718078"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="15,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Background="Transparent" CornerRadius="7" Margin="2,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="#EAF3ED"/><Setter Property="Foreground" Value="#216D4A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="Background" Value="#F1F6F2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGrid"><Setter Property="CanUserResizeColumns" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="46"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1EE"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="FontSize" Value="13"/><Setter Property="AlternatingRowBackground" Value="#FAFCFA"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F9F7"/><Setter Property="Foreground" Value="#76847B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17392C" Padding="25,12"><DockPanel>
                <Button x:Name="ClockButton" DockPanel.Dock="Right" Click="Calendar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Натисніть, щоб відкрити календар" Padding="12,5">
                    <StackPanel HorizontalAlignment="Right"><TextBlock x:Name="ClockTime" Text="--:--:-- · Київ" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="ClockDate" Text="" Foreground="#B8CEC1" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
                </Button>
                <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=ClockButton}" Placement="Bottom" StaysOpen="False">
                    <Border Background="White" BorderBrush="#D9E3DC" BorderThickness="1" CornerRadius="10" Padding="8"><Calendar x:Name="AppCalendar"/></Border>
                </Popup>
                <Image Source="assets/rentsport.png" Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="RentSport" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="Облік прокату спорядження" Foreground="#B8CEC1" FontSize="12" Margin="0,3,0,0"/></StackPanel>
            </DockPanel></Border>
        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Margin="25,0,25,12" Foreground="#247552" FontSize="12" MinHeight="18"/>
        <TabControl Margin="20,16" Background="Transparent" BorderThickness="0">
            <TabItem Header="Огляд"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,16,8,10">
                <TextBlock Text="Огляд прокату" FontSize="24" FontWeight="Bold"/><TextBlock Text="Коротка інформація про залишки та поточні видачі" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                <UniformGrid Columns="3" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ОДИНИЦЬ ІНВЕНТАРЮ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AllCount" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ДОСТУПНО" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FreeCount" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="АКТИВНІ ОРЕНДИ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RentCount" FontSize="30" FontWeight="Bold" Foreground="#C27A32" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Активні оренди" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid x:Name="RentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="280"><DataGrid.Columns><DataGridTextColumn Header="КЛІЄНТ" Binding="{Binding Client}" Width="*"/><DataGridTextColumn Header="СПОРЯДЖЕННЯ" Binding="{Binding Item}" Width="*"/><DataGridTextColumn Header="К-СТЬ" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="ПОВЕРНУТИ ДО" Binding="{Binding EndDate}" Width="105"/><DataGridTemplateColumn Header="ДІЯ" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Повернути" Tag="{Binding Id}" Click="Return_Click" Style="{StaticResource SoftButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Клієнти"><Grid Margin="8,16,8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Новий клієнт" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ClientName" Width="230" ToolTip="Ім’я клієнта"/><TextBox x:Name="ClientPhone" Width="190" MaxLength="19" Margin="8,0,0,0" TextChanged="Phone_TextChanged" ToolTip="Введіть 9 цифр номера після +380"/><Button Content="Додати клієнта" Click="AddClient_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border><TextBox x:Name="ClientSearch" TextChanged="ClientSearch_Changed" ToolTip="Пошук за ім’ям або телефоном" Margin="0,0,0,12"/></StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ClientGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="ІМ’Я" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ТЕЛЕФОН" Binding="{Binding Phone}" Width="190"/><DataGridTemplateColumn Header="ДІЇ" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Змінити" Tag="{Binding Id}" Click="EditClient_Click" Style="{StaticResource SoftButton}" Margin="2,0"/><Button Content="Копія" Tag="{Binding Phone}" Click="CopyPhone_Click" Style="{StaticResource SoftButton}" Margin="2,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
            </Grid></TabItem>
            <TabItem Header="Інвентар"><Grid Margin="8,16,8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Додати спорядження" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="ItemName" IsEditable="True" SelectionChanged="ItemName_SelectionChanged" Width="210" ToolTip="Виберіть типове спорядження або введіть нове"/><ComboBox x:Name="ItemCategory" IsEditable="True" Width="170" Margin="8,0,0,0" ToolTip="Виберіть або введіть нову категорію"/><TextBox x:Name="ItemQty" Width="75" Margin="8,0,0,0" Text="1" ToolTip="Кількість одиниць"/><Button Content="Додати" Click="AddItem_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border><TextBox x:Name="ItemSearch" TextChanged="ItemSearch_Changed" ToolTip="Пошук за назвою або категорією" Margin="0,0,0,12"/></StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ItemGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="НАЗВА" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="КАТЕГОРІЯ" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="УСЬОГО" Binding="{Binding Quantity}" Width="55"/><DataGridTextColumn Header="В ОРЕНДІ" Binding="{Binding Rented}" Width="65"/><DataGridTextColumn Header="РЕМОНТ" Binding="{Binding RepairCount}" Width="55"/><DataGridTextColumn Header="СПИСАНО" Binding="{Binding WrittenOff}" Width="60"/><DataGridTextColumn Header="ВІЛЬНО" Binding="{Binding Available}" Width="55"/><DataGridTextColumn Header="СТАН" Binding="{Binding Status}" Width="110"/><DataGridTemplateColumn Header="ДІЇ" Width="225"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Змінити" Tag="{Binding Id}" Click="EditItem_Click" Style="{StaticResource SoftButton}" Margin="2,0"/><Button Content="Ремонт" Tag="{Binding Id}" Click="Repair_Click" Style="{StaticResource SoftButton}" Margin="2,0"/><Button Content="Списати" Tag="{Binding Id}" Click="Writeoff_Click" Style="{StaticResource SoftButton}" Margin="2,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
            </Grid></TabItem>
            <TabItem Header="Нова оренда"><StackPanel Margin="8,16" MaxWidth="550" HorizontalAlignment="Left"><TextBlock Text="Оформити оренду" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/><TextBlock Text="Вкажіть клієнта, спорядження, кількість та дату повернення" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/><Border Style="{StaticResource Card}" Width="500"><StackPanel><TextBlock Text="Клієнт" FontWeight="SemiBold"/><TextBox x:Name="RentClientSearch" TextChanged="RentClientSearch_Changed" ToolTip="Пошук клієнта за ім’ям або телефоном" Margin="0,6,0,6"/><ComboBox x:Name="RentClient" DisplayMemberPath="Name" Margin="0,0,0,14"/><TextBlock Text="Спорядження" FontWeight="SemiBold"/><ComboBox x:Name="RentItem" DisplayMemberPath="Label" Margin="0,6,0,14"/><TextBlock Text="Кількість" FontWeight="SemiBold"/><TextBox x:Name="RentQty" Text="1" Margin="0,6,0,14"/><TextBlock Text="Дата початку оренди" FontWeight="SemiBold"/><DatePicker x:Name="RentStartDate" Margin="0,6,0,14"/><TextBlock Text="Дата повернення" FontWeight="SemiBold"/><DatePicker x:Name="RentEndDate" Margin="0,6,0,18"/><Button Content="Підтвердити видачу" Click="Rent_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/></StackPanel></Border></StackPanel></TabItem>
            <TabItem Header="Історія"><Grid Margin="8,16,8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Історія оренд" FontSize="24" FontWeight="Bold"/><TextBlock Text="Записи про повернення, стан речей та штрафи" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" ToolTip="Пошук за клієнтом, спорядженням або нотаткою" Margin="0,0,0,12"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="КЛІЄНТ" Binding="{Binding Client}" Width="*"/><DataGridTextColumn Header="СПОРЯДЖЕННЯ" Binding="{Binding Item}" Width="*"/><DataGridTextColumn Header="ШТ" Binding="{Binding Quantity}" Width="45"/><DataGridTextColumn Header="ВИДАНО" Binding="{Binding StartDate}" Width="85"/><DataGridTextColumn Header="ДО" Binding="{Binding EndDate}" Width="85"/><DataGridTextColumn Header="ПОВЕРНУТО" Binding="{Binding ReturnedAt}" Width="90"/><DataGridTextColumn Header="ШТРАФ" Binding="{Binding FineText}" Width="140"/><DataGridTextColumn Header="НОТАТКА" Binding="{Binding NoteSummary}" Width="150"/><DataGridTextColumn Header="СТАН" Binding="{Binding State}" Width="85"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
            <TabItem Header="Ремонти"><Grid Margin="8,16,8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Журнал ремонтів" FontSize="24" FontWeight="Bold"/><TextBlock Text="Передачі в ремонт, повернення та витрати" Foreground="{StaticResource Muted}" Margin="0,4,0,5"/><TextBlock x:Name="RepairTotal" Foreground="{StaticResource Green}" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="RepairSearch" TextChanged="RepairSearch_Changed" ToolTip="Пошук за спорядженням, дією або нотаткою" Margin="0,0,0,12"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="RepairGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="СПОРЯДЖЕННЯ" Binding="{Binding Item}" Width="*"/><DataGridTextColumn Header="ДАТА / ЧАС" Binding="{Binding Date}" Width="155"/><DataGridTextColumn Header="ДІЯ" Binding="{Binding Action}" Width="155"/><DataGridTextColumn Header="КІЛЬКІСТЬ" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="ВИТРАТИ" Binding="{Binding CostText}" Width="110"/><DataGridTextColumn Header="НОТАТКА" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
        </TabControl>
    </DockPanel>
</Window>


